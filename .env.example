# 투리 환경변수 목록 — 이름만 있고 값은 비어 있다.
# 실제 값은 .env.local 에 넣는다(.env.local은 GitHub에 올라가지 않는다). 값은 nnoinn이 팀원 4명 단톡방으로 준다.
# NEXT_PUBLIC_ 으로 시작하는 값만 브라우저에 보인다. 나머지는 서버 전용 비밀값.
# 자세한 설명: docs/tech-guide.md "8. 개발과 확인 환경"

# Supabase (개발용 프로젝트 toori-dev)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=

# 카카오
NEXT_PUBLIC_KAKAO_MAP_JS_KEY=
KAKAO_REST_API_KEY=

# 정산 계좌 암호화 (서버 전용, AES-256-GCM용 32바이트 무작위 값을 base64로)
PAYOUT_ACCOUNT_ENCRYPTION_KEY=
