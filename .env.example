# 투리 환경변수 목록 — 이름만 있고 값은 비어 있다.
# 실제 값은 .env.local 에 넣는다(.env.local은 GitHub에 올라가지 않는다). 값은 nnoinn이 팀원 4명 단톡방으로 준다.
# NEXT_PUBLIC_ 으로 시작하는 값만 브라우저에 보인다. 나머지는 서버 전용 비밀값.
# 자세한 설명: docs/tech-guide.md "8. 개발과 확인 환경"

# Supabase (개발용 프로젝트 toori-dev)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=

# 카카오
NEXT_PUBLIC_KAKAO_MAP_JS_KEY=
KAKAO_REST_API_KEY=

# 정산 계좌 암호화 (서버 전용, AES-256-GCM용 32바이트 무작위 값을 base64로)
PAYOUT_ACCOUNT_ENCRYPTION_KEY=

# 로그인(W2) 전 가짜 로그인 (#83). 내 컴퓨터의 npm run dev에서만 동작하고, 배포·미리보기·테스트에서는 늘 로그인 안 함.
# 시드 계정(@seed.test)만 쓸 수 있다. 키가 아니라 공개돼도 되는 값. 바꾸면 dev 서버를 다시 켠다. W2 머지 뒤 지운다
# 원장님: owner-a@seed.test(샘플 헤어 중앙역점, 매물 상태 6가지), owner-b(승인 대기), owner-c(반려), owner-d(다른 원장님) + DEV_LOGIN_MODE=owner
# 고객: customer-a@seed.test(이력 없음), customer-b(A 샵 기존 고객), customer-c(예정·이용 완료·취소 예약) + DEV_LOGIN_MODE=customer
DEV_LOGIN_EMAIL=
DEV_LOGIN_MODE=
