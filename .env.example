# 줍줍 환경변수 목록 — 이름만 있고 값은 비어 있다.
# 실제 값은 .env.local 에 넣는다(.env.local은 GitHub에 올라가지 않는다). 값은 nnoinn에게 1:1로 받는다.
# NEXT_PUBLIC_ 으로 시작하는 값만 브라우저에 보인다. 나머지는 서버 전용 비밀값.
# 자세한 설명: docs/tech-guide.md "8. 개발과 확인 환경"

# Supabase (개발용 프로젝트 jupjup-dev)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=

# 카카오
NEXT_PUBLIC_KAKAO_MAP_JS_KEY=
KAKAO_REST_API_KEY=
